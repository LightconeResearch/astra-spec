    "https://w3id.org/astra/dev/provenance.schema.json#/$defs/Runner/properties/id/type": "WRONG_TYPE",
    "https://w3id.org/astra/dev/provenance.schema.json#/$defs/Runner/properties/version/type": "WRONG_TYPE",
