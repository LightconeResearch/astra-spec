    "https://w3id.org/astra/provenance.schema.json#/properties/content_hash/type": "WRONG_TYPE",
    "https://w3id.org/astra/provenance.schema.json#/properties/size/minimum": "INVALID_VALUE",
    "https://w3id.org/astra/provenance.schema.json#/properties/size/type": "WRONG_TYPE",
    "https://w3id.org/astra/provenance.schema.json#/properties/spec_version/pattern": "INVALID_VALUE",
    "https://w3id.org/astra/provenance.schema.json#/properties/spec_version/type": "WRONG_TYPE",
    "https://w3id.org/astra/provenance.schema.json#/required": "MISSING_FIELD",
    "https://w3id.org/astra/provenance.schema.json#/type": "WRONG_TYPE"
  },
  "rules": [
    {
      "code": "INVALID_SYNTAX",
      "layer": "parse",
      "level": "MUST",
      "source": "§3, 0005",
      "statement": "Every `astra.yaml` is well-formed YAML 1.2 under the core schema (with no `%YAML` directive other than 1.2), and every record is well-formed JSON"
    },
    {
      "code": "DUPLICATE_KEY",
      "layer": "parse",
      "level": "MUST",
      "source": "0003, 0004, §3, §4",
      "statement": "Every key of a map is distinct: no two are equal YAML nodes, with the same tag and canonical form. (This makes the ids of inputs, outputs, decisions, options, insights, universes and declarations unique.)"
    },
    {
      "code": "INVALID_ID",
      "layer": "schema",
      "level": "MUST",
      "source": "§4",
      "statement": "Every map key matches its key's type (an `id`, or an `address` in `Universe.decisions`), and every `id`-typed value matches the `id` grammar"
    },
    {
      "code": "INVALID_REFERENCE",
      "layer": "schema",
      "level": "MUST",
      "source": "0003, 0004",
      "statement": "Every address, reference, option reference and condition matches its grammar"
    },
    {
      "code": "MISSING_FIELD",
      "layer": "schema",
      "level": "MUST",
      "source": "0004, 0005, 0006, tidy-up",
      "statement": "Every required field is present: `spec_version`, `outputs`, `Output.type`, `Output.format`, `Input.path`, `Decision.options`, `Insight.claim`, `Insight.evidence`, `TextQuoteSelector.exact`, `FragmentSelector.value`, and the record's (§8)"
    },
    {
      "code": "UNKNOWN_FIELD",
      "layer": "schema",
      "level": "MUST",
      "source": "§10",
      "statement": "Every field is one the schema defines"
    },
    {
      "code": "EMPTY_COLLECTION",
      "layer": "schema",
      "level": "MUST",
      "source": "0004, `main`",
      "statement": "`outputs`, `Decision.options` and `Insight.evidence` each have at least one entry"
    },
    {
      "code": "INVALID_DECLARATION_SOURCE",
      "layer": "schema",
      "level": "MUST",
      "source": "0007",
      "statement": "A declaration has exactly one of `path` and `url`"
    },
    {
      "code": "URL_WITHOUT_COMMIT",
      "layer": "schema",
      "level": "MUST",
      "source": "0007",
      "statement": "A declaration with a `url` has a `commit`"
    },
    {
      "code": "INVALID_COMMIT",
      "layer": "schema",
      "level": "MUST",
      "source": "0007",
      "statement": "Every `commit` is a full commit id: 40 or 64 lowercase hexadecimal digits"
    },
    {
      "code": "INVALID_PATH",
      "layer": "schema",
      "level": "MUST",
      "source": "0004, 0006",
      "statement": "A declaration's `path` is relative (no leading `/` or `~`), `/`-separated, with no backslash and no ASCII control character. An input's `path` is the same, and also has no `..` segment and doesn't end in `/`"
    },
    {
      "code": "BLANK_EXCLUDED",
      "layer": "schema",
      "level": "MUST",
      "source": "tidy-up",
      "statement": "An option's `excluded` reason is not blank"
    },
    {
      "code": "INVALID_EVIDENCE_SOURCE",
      "layer": "schema",
      "level": "MUST",
      "source": "tidy-up",
      "statement": "Evidence has exactly one of `doi` and `artifact`, and has a `version` only with a `doi`"
    },
    {
      "code": "WRONG_TYPE",
      "layer": "schema",
      "level": "MUST",
      "source": "§4, §10",
      "statement": "Every value has the JSON type its field takes: a string, an integer, a list or a map (so `excluded: true`, or a list where a map is expected, fails)"
    },
    {
      "code": "DUPLICATE_ENTRY",
      "layer": "schema",
      "level": "MUST",
      "source": "§4",
      "statement": "No list of strings holds the same entry twice (`Output.inputs`, `Output.decisions`, `when`, `requires`, `incompatible_with`, `insights`, `tags`)"
    },
    {
      "code": "INVALID_VALUE",
      "layer": "schema",
      "level": "MUST",
      "source": "0005, 0007, #73",
      "statement": "Every value matches its pattern, enumeration or range: `Output.type` (one of `OutputType`), `Output.format`, `Evidence.doi`, `AnalysisDeclaration.url` (a remote URL), every hash, IRI and time, every `spec_version`, `size` ≥ 0, `Evidence.version` ≥ 1, `Resources.cpus` ≥ 0 and `Resources.gpus` ≥ 1"
    },
    {
      "code": "UNSUPPORTED_SPEC_VERSION",
      "layer": "validator",
      "level": "MUST",
      "source": "0007 §6",
      "statement": "Every `astra.yaml` in the stack has a `spec_version` the validator has the schema for (the file is then validated against that schema, by the schema layer)"
    },
    {
      "code": "UNRESOLVED_ADDRESS",
      "layer": "validator",
      "level": "MUST",
      "source": "0004",
      "statement": "Every address resolves, through the declarations, to an element of the kind its field takes: an input or output in `Output.inputs`, a decision in `Output.decisions` and in `Universe.decisions` keys, a decision in conditions and option references, an output in `Evidence.artifact`"
    },
    {
      "code": "UNKNOWN_OPTION",
      "layer": "validator",
      "level": "MUST",
      "source": "0003",
      "statement": "Every option named by a condition, option reference or selection is one of its decision's options"
    },
    {
      "code": "INVALID_INSIGHT_REF",
      "layer": "validator",
      "level": "MUST",
      "source": "`main`",
      "statement": "Every entry of `Option.insights` names a prior insight of the analysis"
    },
    {
      "code": "UNDECLARED_TEMPLATE_REF",
      "layer": "validator",
      "level": "MUST",
      "source": "0003, 0004",
      "statement": "Every recipe placeholder is `{inputs}`, `{output}`, `{{`, `}}`, or an `{inputs.<entry>}` or `{decisions.<entry>}` whose `<entry>` is an entry of its output's `inputs` or `decisions` exactly as written"
    },
    {
      "code": "AMBIGUOUS_ID",
      "layer": "validator",
      "level": "MUST",
      "source": "§4",
      "statement": "No two elements that one field could resolve to share an id (an input and an output, both of which `Output.inputs` takes)"
    },
    {
      "code": "DECLARATION_OUTSIDE_REPOSITORY",
      "layer": "validator",
      "level": "MUST",
      "source": "0004",
      "statement": "A declaration's `path` stays inside the repository of the root"
    },
    {
      "code": "MISSING_DECLARED_ANALYSIS",
      "layer": "validator",
      "level": "MUST",
      "source": "0004, 0007",
      "statement": "A declaration's `path` (at its `commit`, if it has one), or the top level of its `url`'s repository at its `commit`, holds an `astra.yaml`"
    },
    {
      "code": "COMMIT_NOT_FOUND",
      "layer": "validator",
      "level": "MUST",
      "source": "0007",
      "statement": "A declaration with a `path` and a `commit` names a commit the repository has"
    },
    {
      "code": "COMMIT_NOT_ANCESTOR",
      "layer": "validator",
      "level": "SHOULD",
      "source": "0007",
      "statement": "A declaration with a `path` and a `commit` names an ancestor of the commit the declaration is in"
    },
    {
      "code": "REMOTE_UNREACHABLE",
      "layer": "validator",
      "level": "MUST",
      "source": "0007",
      "statement": "A declaration's `url` can be fetched and has its `commit`"
    },
    {
      "code": "DECLARED_ANALYSIS_INVALID",
      "layer": "validator",
      "level": "MUST",
      "source": "0007",
      "statement": "An analysis from a commit, with everything it declares, is valid at that commit"
    },
    {
      "code": "MISSING_INPUT_FILE",
      "layer": "validator",
      "level": "MUST",
      "source": "0006",
      "statement": "An input's `path` names a file, or something standing in for one"
    },
    {
      "code": "INPUT_NOT_TRACKED",
      "layer": "validator",
      "level": "MUST",
      "source": "0006",
      "statement": "An input's file, or what stands in for it, is tracked in git"
    },
    {
      "code": "INPUT_IN_ANOTHER_ANALYSIS",
      "layer": "validator",
      "level": "MUST",
      "source": "0006",
      "statement": "An input's file is outside every other analysis's directory"
    },
    {
      "code": "UNKNOWN_DERIVED_FROM",
      "layer": "validator",
      "level": "MUST",
      "source": "0003",
      "statement": "A universe's `derived_from` names a universe of the same analysis"
    },
    {
      "code": "DERIVED_FROM_CYCLE",
      "layer": "validator",
      "level": "MUST",
      "source": "0003",
      "statement": "No universe is derived from itself, directly or through others"
    },
    {
      "code": "MISSING_DECISION",
      "layer": "validator",
      "level": "MUST",
      "source": "0003, 0004",
      "statement": "Every universe's effective selection sets every active decision of its analysis and of every analysis it drives"
    },
    {
      "code": "INACTIVE_DECISION",
      "layer": "validator",
      "level": "MUST",
      "source": "0003",
      "statement": "A universe itself sets only decisions whose `when` holds in its effective selection"
    },
    {
      "code": "MISSING_REQUIRED_OPTION",
      "layer": "validator",
      "level": "MUST",
      "source": "0003",
      "statement": "Every effective selection satisfies the `requires` of every option it selects"
    },
    {
      "code": "INCOMPATIBLE_OPTIONS",
      "layer": "validator",
      "level": "MUST",
      "source": "0003",
      "statement": "Every effective selection satisfies the `incompatible_with` of every option it selects"
    },
    {
      "code": "EXCLUDED_OPTION_SELECTED",
      "layer": "validator",
      "level": "MUST",
      "source": "`main`, tidy-up",
      "statement": "No effective selection selects an excluded option"
    },
    {
      "code": "PARTIALLY_DRIVEN",
      "layer": "validator",
      "level": "MUST",
      "source": "0004",
      "statement": "Every declaration is driven by all of the driver's universes or by none"
    },
    {
      "code": "CONFLICTING_SELECTIONS",
      "layer": "validator",
      "level": "MUST",
      "source": "0004",
      "statement": "Every spelling of one decision in a universe selects the same option"
    },
    {
      "code": "NOT_BUILT_IN_UNIVERSE",
      "layer": "validator",
      "level": "MUST",
      "source": "0004",
      "statement": "Every output of another analysis read without a pin, and every decision of another analysis, is used only where that analysis is built in the universe being built"
    },
    {
      "code": "UNDRIVEN_DECLARATION",
      "layer": "validator",
      "level": "MUST",
      "source": "0004",
      "statement": "In the file of the analysis whose universe is being built, every such read goes through a declaration that analysis drives"
    },
    {
      "code": "INPUT_NOT_BUILT",
      "layer": "validator",
      "level": "MUST",
      "source": "0004",
      "statement": "Every output read without a pin is active (its `when` holds) in the universe being built"
    },
    {
      "code": "PIN_ON_INPUT",
      "layer": "validator",
      "level": "MUST",
      "source": "0003",
      "statement": "Every pinned reference names an output"
    },
    {
      "code": "UNKNOWN_PIN_UNIVERSE",
      "layer": "validator",
      "level": "MUST",
      "source": "0003, 0004",
      "statement": "Every pin names a universe of the driver, through a driven declaration, or otherwise of the analysis the output belongs to"
    },
    {
      "code": "PIN_INACTIVE",
      "layer": "validator",
      "level": "MUST",
      "source": "0003",
      "statement": "Every pinned output is active in the universe it is pinned to"
    },
    {
      "code": "OUTPUT_CYCLE",
      "layer": "validator",
      "level": "MUST",
      "source": "0004",
      "statement": "No output depends on itself, directly or through others"
    },
    {
      "code": "REDUNDANT_PIN",
      "layer": "validator",
      "level": "SHOULD",
      "source": "0003",
      "statement": "No reference to an output built once has a pin"
    },
    {
      "code": "UNPINNED_EVIDENCE",
      "layer": "validator",
      "level": "SHOULD",
      "source": "0003, 0004",
      "statement": "Every evidence citing an output built per universe pins it"
    },
    {
      "code": "NO_UNIVERSES",
      "layer": "validator",
      "level": "SHOULD",
      "source": "0003, 0004",
      "statement": "Every analysis with decisions, or with outputs built per universe, has universes, unless it is driven or consumes a decision"
    },
    {
      "code": "PIN_LIKE_COMMENT",
      "layer": "validator",
      "level": "SHOULD",
      "source": "0003",
      "statement": "No `inputs` entry has a line comment that looks like a pin (needs the source text)"
    },
    {
      "code": "MISSING_RECORD",
      "layer": "check",
      "level": "MUST",
      "source": "0005 §1",
      "statement": "Every planned result has a record at `.astra/records/{universe}/{name}.json` (or `{name}.json` for an output built once) in the analysis it belongs to",
      "status": "`missing`"
    },
    {
      "code": "INVALID_RECORD",
      "layer": "check",
      "level": "MUST",
      "source": "0005 §2, §8",
      "statement": "Every record is valid against the record schema of its `spec_version`, or against the open variant when that version is newer than the checker's",
      "status": "`missing`"
    },
    {
      "code": "MISPLACED_RECORD",
      "layer": "check",
      "level": "MUST",
      "source": "0005 §1",
      "statement": "Every record's `address` names the result whose record is kept where it is",
      "status": "`missing`"
    },
    {
      "code": "MISSING_RECORD_INPUTS",
      "layer": "check",
      "level": "MUST",
      "source": "0005 §2",
      "statement": "Every record has exactly one `inputs` item for each entry its output lists, matched by `entry` (their order carries no meaning)",
      "status": "`missing`"
    },
    {
      "code": "STALE_RESULT",
      "layer": "check",
      "level": "MUST",
      "source": "0005 §4",
      "statement": "Since the commit in a result's record, nothing has changed in its output's declaration (command, inputs and their order, decisions, format), its decisions' options, its inputs' content, or the results it reads",
      "status": "`stale`"
    },
    {
      "code": "ABSENT_RESULT",
      "layer": "check",
      "level": "SHOULD",
      "source": "0005 §1",
      "statement": "Every result's recorded bytes are at its default place",
      "status": "`absent`, or `modified`"
    },
    {
      "code": "STALE_EVIDENCE",
      "layer": "check",
      "level": "MUST",
      "source": "0005 §5",
      "statement": "Every evidence citing a result cites an unchanged one",
      "status": "the cited result's status"
    },
    {
      "code": "UNRECORDED_RESULT",
      "layer": "runner",
      "level": "MUST",
      "source": "0005 §1, 0005 §3",
      "statement": "A runner writes a record for every result it makes, in the analysis the result belongs to, and writes the bytes to their default place"
    },
    {
      "code": "UNCOMMITTED_CHANGES",
      "layer": "runner",
      "level": "MUST",
      "source": "0005 §3",
      "statement": "A runner runs only when the repository has no changes other than the results and records it writes"
    },
    {
      "code": "UNRECREATABLE_ENVIRONMENT",
      "layer": "runner",
      "level": "MUST",
      "source": "0005 §3",
      "statement": "A runner records each recipe's environment as an IRI that it can recreate at its version"
    },
    {
      "code": "UNDECLARED_READ",
      "layer": "runner",
