    "https://w3id.org/astra/dev/provenance.schema.json#/properties/address/type": "WRONG_TYPE",
    "https://w3id.org/astra/dev/provenance.schema.json#/properties/content_hash/pattern": "INVALID_VALUE",
    "https://w3id.org/astra/dev/provenance.schema.json#/properties/content_hash/type": "WRONG_TYPE",
    "https://w3id.org/astra/dev/provenance.schema.json#/properties/size/minimum": "INVALID_VALUE",
    "https://w3id.org/astra/dev/provenance.schema.json#/properties/size/type": "WRONG_TYPE",
    "https://w3id.org/astra/dev/provenance.schema.json#/properties/spec_version/pattern": "INVALID_VALUE",
    "https://w3id.org/astra/dev/provenance.schema.json#/properties/spec_version/type": "WRONG_TYPE",
    "https://w3id.org/astra/dev/provenance.schema.json#/required": "MISSING_FIELD",
    "https://w3id.org/astra/dev/provenance.schema.json#/type": "WRONG_TYPE"
  },
  "rules": [
    {
      "code": "INVALID_SYNTAX",
      "layer": "parse",
      "level": "MUST",
      "statement": "An `astra.yaml` is a YAML 1.2 document holding a map; A record is UTF-8 JSON text, no object repeating a name"
    },
    {
      "code": "MISSING_FIELD",
      "layer": "schema",
      "level": "MUST",
      "statement": "`astra.yaml` has `spec_version` and `outputs`; an output, `type`, `format` and `recipe.command`; An input has `path`; a decision, `options`; an insight, `claim`, `evidence`; `quote`, `exact`; `location`, `value`; A record has every field but `started`, `finished` and `inputs`"
    },
    {
      "code": "UNKNOWN_FIELD",
      "layer": "schema",
      "level": "MUST",
      "statement": "Every field is one the schema defines"
    },
    {
      "code": "WRONG_TYPE",
      "layer": "schema",
      "level": "MUST",
      "statement": "Every value has its field's JSON type, never null (leave an optional field out)"
    },
    {
      "code": "EMPTY_COLLECTION",
      "layer": "schema",
      "level": "MUST",
      "statement": "`outputs`, `options`, `evidence` and every list of strings in `astra.yaml` are non-empty"
    },
    {
      "code": "DUPLICATE_ENTRY",
      "layer": "schema",
      "level": "MUST",
      "statement": "No list of strings holds one entry twice"
    },
    {
      "code": "INVALID_VALUE",
      "layer": "schema",
      "level": "MUST",
      "statement": "`type` is `metric`, `figure`, `table`, `data` or `report`; `format` matches `^[a-z0-9][a-z0-9_.+-]*$`; Every `spec_version`, hash, IRI, time, `doi`, `url` and location `value` has its form; `size` ≥ 0, evidence `version` ≥ 1, `resources.cpus` ≥ 0, `resources.gpus` ≥ 1"
    },
    {
      "code": "INVALID_ID",
      "layer": "schema",
      "level": "MUST",
      "statement": "Map keys and id-typed values are ids; a universe's `decisions` keys are addresses"
    },
    {
      "code": "INVALID_REFERENCE",
      "layer": "schema",
      "level": "MUST",
      "statement": "Every address, reference, option reference and condition, bar universe keys, matches its grammar"
    },
    {
      "code": "INVALID_PATH",
      "layer": "schema",
      "level": "MUST",
      "statement": "Every input's and declaration's `path` is non-empty and doesn't start with `/`"
    },
    {
      "code": "INVALID_IMPORT",
      "layer": "schema",
      "level": "MUST",
      "statement": "A `universes` entry with `analysis` or `universe` has both, and no `decisions` or `derived_from`"
    },
    {
      "code": "INVALID_EVIDENCE_SOURCE",
      "layer": "schema",
      "level": "MUST",
      "statement": "Evidence has exactly one of `doi` and `artifact`, and `version` only with `doi`"
    },
    {
      "code": "INVALID_DECLARATION_SOURCE",
      "layer": "schema",
      "level": "MUST",
      "statement": "A declaration has exactly one of `path` and `url`"
    },
    {
      "code": "URL_WITHOUT_COMMIT",
      "layer": "schema",
      "level": "MUST",
      "statement": "A declaration with a `url` has a `commit`"
    },
    {
      "code": "INVALID_COMMIT",
      "layer": "schema",
      "level": "MUST",
      "statement": "Every `commit` is a full commit id: 40 or 64 lowercase hex digits"
    },
    {
      "code": "NOT_IN_REPOSITORY",
      "layer": "validator",
      "level": "MUST",
      "statement": "The driving analysis is in a git repository's working tree"
    },
    {
      "code": "MISSING_INPUT_FILE",
      "layer": "validator",
      "level": "MUST",
      "statement": "An input's `path` names a file (no symlink, folder or gitlink) or a stand-in"
    },
    {
      "code": "INPUT_NOT_TRACKED",
      "layer": "validator",
      "level": "MUST",
      "statement": "An input's file or stand-in is tracked in its analysis's repository"
    },
    {
      "code": "INPUT_IN_ANOTHER_ANALYSIS",
      "layer": "validator",
      "level": "MUST",
      "statement": "An input's file is in its analysis's folder, in no **nested analysis** (a folder below with an `astra.yaml`)"
    },
    {
      "code": "RESERVED_PATH",
      "layer": "validator",
      "level": "MUST",
      "statement": "No input or declaration `path` is, or lies inside, a stack analysis's `results/` or `.astra/` in its tree"
    },
    {
      "code": "MISSING_DECLARED_ANALYSIS",
      "layer": "validator",
      "level": "MUST",
      "statement": "A declared folder holds an `astra.yaml`, reached through no symlink"
    },
    {
      "code": "DECLARATION_OUTSIDE_REPOSITORY",
      "layer": "validator",
      "level": "MUST",
      "statement": "A tidied declaration `path` doesn't go above the top of the driving analysis's working tree or, at a commit, of its repository"
    },
    {
      "code": "COMMIT_NOT_FOUND",
      "layer": "validator",
      "level": "MUST",
      "statement": "In a file not read from a remote, a `path` and `commit` name a commit of the file's repository"
    },
    {
      "code": "DECLARED_ANALYSIS_INVALID",
      "layer": "validator",
      "level": "MUST",
      "statement": "An analysis from a commit, with all it declares, is valid at that commit"
    },
    {
      "code": "UNRESOLVED_ADDRESS",
      "layer": "validator",
      "level": "MUST",
      "statement": "An address in `inputs` reaches an input or output; in `artifact`, an output; In `decisions`, universe keys, conditions and option references, a decision; in an import, another analysis's universe"
    },
    {
      "code": "AMBIGUOUS_ID",
      "layer": "validator",
      "level": "MUST",
      "statement": "No input and output of one analysis share an id"
    },
    {
      "code": "CLASHING_RESULT_NAME",
      "layer": "validator",
      "level": "MUST",
      "statement": "No output shares its id with a declaration of its analysis"
    },
    {
      "code": "UNKNOWN_OPTION",
      "layer": "validator",
      "level": "MUST",
      "statement": "Each option a condition, option reference or selection names is one of its decision's"
    },
    {
      "code": "INVALID_INSIGHT_REF",
      "layer": "validator",
      "level": "MUST",
      "statement": "An option's `insights` name prior insights of its analysis"
    },
    {
      "code": "OUTPUT_CYCLE",
      "layer": "validator",
      "level": "MUST",
      "statement": "No output reads itself through `inputs`, directly or not, pinned or not"
    },
    {
      "code": "UNDECLARED_TEMPLATE_REF",
      "layer": "validator",
      "level": "MUST",
      "statement": "Every brace of a `command`, read from the left, is in `{{`, `}}` or a placeholder; Placeholders are `{inputs}`, `{output}`, and `{inputs.<entry>}` or `{decisions.<entry>}` for entries as listed"
    },
    {
      "code": "UNKNOWN_DERIVED_FROM",
      "layer": "validator",
      "level": "MUST",
      "statement": "`derived_from` names a universe of its analysis, never an import"
    },
    {
      "code": "DERIVED_FROM_CYCLE",
      "layer": "validator",
      "level": "MUST",
      "statement": "No chain of `derived_from` loops back to its universe"
    },
    {
      "code": "INACTIVE_DECISION",
      "layer": "validator",
      "level": "MUST",
      "statement": "A universe's own `decisions` set only decisions active in its effective selection"
    },
    {
      "code": "MISSING_DECISION",
      "layer": "validator",
      "level": "MUST",
      "statement": "An effective selection sets every active decision of its analysis and of those its universes drive"
    },
    {
      "code": "MISSING_REQUIRED_OPTION",
      "layer": "validator",
      "level": "MUST",
      "statement": "An effective selection meets the `requires` of each option it selects"
    },
    {
      "code": "INCOMPATIBLE_OPTIONS",
      "layer": "validator",
      "level": "MUST",
      "statement": "An effective selection meets the `incompatible_with` of each option it selects"
    },
    {
      "code": "EXCLUDED_OPTION_SELECTED",
      "layer": "validator",
      "level": "MUST",
      "statement": "No effective selection selects an excluded option"
    },
    {
      "code": "DUPLICATE_ELEMENT",
      "layer": "validator",
      "level": "MUST",
      "statement": "No two keys of a universe's own `decisions` name one decision; A universe sets an inherited decision only under the key it inherits"
    },
    {
      "code": "LOOPING_KEY",
      "layer": "validator",
      "level": "MUST",
      "statement": "No universe key goes through a declaration that leads back"
    },
    {
      "code": "UNKNOWN_PIN_UNIVERSE",
      "layer": "validator",
      "level": "MUST",
      "statement": "Every pin names a universe: its analysis's entry or, lacking one, that of the analysis whose output it reads"
    },
    {
      "code": "PIN_INACTIVE",
      "layer": "validator",
      "level": "MUST",
      "statement": "Every pinned output is active in the universe it is pinned to"
    },
    {
      "code": "INPUT_NOT_BUILT",
      "layer": "validator",
      "level": "MUST",
      "statement": "Every output a result planned in a universe reads without a pin is active there"
    },
    {
      "code": "NOT_BUILT_IN_UNIVERSE",
      "layer": "validator",
      "level": "MUST",
      "statement": "An output reading another analysis's output built per universe, unpinned or pinned to a universe it is built in, or one of its decisions, reads it from an analysis built in that universe"
    },
    {
      "code": "UNDRIVEN_DECLARATION",
      "layer": "validator",
      "level": "MUST",
      "statement": "In the file of a universe's analysis, every address using another analysis's element there has a driven chain"
    },
    {
      "code": "RESULT_IN_TWO_PLACES",
      "layer": "validator",
      "level": "SHOULD",
      "statement": "No planned result has two names"
    },
    {
      "code": "MISSING_RECORD",
      "layer": "check",
      "level": "MUST",
      "statement": "Every planned result has a record at each of its places",
      "status": "`missing`"
    },
    {
      "code": "INVALID_RECORD",
      "layer": "check",
      "level": "MUST",
      "statement": "The record at each place parses; its minor version has a record schema or exceeds the checker's; It meets that record schema or, if newer, the checker's open variant",
      "status": "`missing`"
    },
    {
      "code": "MISPLACED_RECORD",
      "layer": "check",
      "level": "MUST",
      "statement": "Its `address` is the one its place is worked out from",
      "status": "`missing`"
    },
    {
      "code": "MISSING_RECORD_INPUTS",
      "layer": "check",
      "level": "MUST",
      "statement": "Its `inputs` hold one item per entry its output lists at its commit, by `entry`, no more",
      "status": "`missing`"
    },
    {
      "code": "STALE_RESULT",
      "layer": "check",
      "level": "MUST",
      "statement": "Nothing the result is made from has changed since its record's commit",
      "status": "`stale`"
    },
    {
      "code": "ABSENT_RESULT",
      "layer": "check",
      "level": "SHOULD",
      "statement": "Its recorded bytes are at its default place, bar an unread result from a commit",
      "status": "`absent`"
    },
